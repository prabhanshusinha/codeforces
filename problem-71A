#include<iostream>
#include<vector>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<string>ch;
    string p;
    for(int i=1;i<=n;i++){
        cin>>p;
        ch.push_back(p);
    }
    for(string c :ch){
        int l= c.size();
        if(l<=10) cout<<c<<endl;
        else{
            cout<<c[0]<<l-2<<c[l-1]<<endl;
        }
    }
    return 0;
}