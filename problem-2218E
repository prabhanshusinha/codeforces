#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main(){
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int p;
        cin>>p;
        vector<int>v(p);
        int inp;
        for(int j=0;j<p;j++){
            cin>>v[j];
        }
        int ans =0;
        for(int j=0;j<p;j++){
            for(int k=j+1;k<p;k++){
                ans = max(ans,v[j]^v[k]);
            }
        }
        cout<<ans<<endl;
    }
    return 0;
}