#include<iostream>
#include<vector>
using namespace std;
int main(){
    int p;
    vector<vector<int>>v(5,vector<int>(5));
    for(int i=0;i<5;i++){
        for(int j=0;j<5;j++){
            cin>>p;
            v[i][j]=p;
        }
    }
    int count=0;
    for(int i=0;i<5;i++){
        for(int j=0;j<5;j++){
            if(v[i][j]==1){
                count= count+abs(2-i)+abs(2-j);
            }
        }
    }
    cout<<count;
}