#include<iostream>
#include<vector>
using namespace std;
int main(){
    int n,k,p;
    cin>>n>>k;
    vector<int>v;
    for(int i=0;i<n;i++){
        cin>>p;
        v.push_back(p);
    }
    int count=0;
    for(int i=0;i<n;i++){
        if(v[i]>=v[k-1] && v[i]!=0) count++;
    }
    cout<<count;
}