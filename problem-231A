#include<iostream>
#include<vector>
using namespace std;
int main(){
    int n ;
    cin>>n;
    int p;
    int count=0;
    vector<int>v;
    for(int i=0;i<(3*n);i++){
        cin>>p;
        v.push_back(p);
    }
    int idx=1;
    for(int i=1;i<=n;i++){
        int su=0;
        for(int j=idx;j<=(3*i);j++){
            su+=v[j-1];
            idx++;
        }
        if(su>=2) count++;
    }
    cout<<count;
}